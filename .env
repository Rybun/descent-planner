# URL base de la API de shares (vacío = mismo origen, proxeado por nginx)
VITE_SHARE_API_URL=

# Base para los enlaces cortos que se muestran al usuario.
# Vacío = window.location.origin (p.ej. https://descent.rybun.rocks)
# Cuando d.rybun.rocks esté configurado en NPM: VITE_SHARE_LINK_BASE=https://d.rybun.rocks
VITE_SHARE_LINK_BASE=
